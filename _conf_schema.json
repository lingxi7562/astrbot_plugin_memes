{
  "index_path": {
    "description": "表情包标签索引文件路径",
    "type": "string",
    "hint": "image_index.json 的绝对路径（Docker 内为 /AstrBot/data/... 开头）",
    "obvious_hint": true,
    "default": "/AstrBot/data/plugin_data/astrbot_plugin_smart_imagechat_hub/image_index.json"
  },
  "data_root": {
    "description": "表情包数据根目录",
    "type": "string",
    "hint": "用于拼接 rel_path 得到图片绝对路径",
    "default": "/AstrBot/data/plugin_data/astrbot_plugin_smart_imagechat_hub/"
  },
  "library_sources": {
    "description": "额外模板库来源",
    "type": "template_list",
    "hint": "最多 32 个来源；路径必须为绝对路径。禁用的来源会保留配置但不会加载。",
    "default": [],
    "templates": {
      "json": {
        "name": "JSON 索引来源",
        "hint": "加载兼容 images 字段的 JSON 索引，并从数据根目录解析 rel_path。",
        "display_item": "namespace",
        "hide_hint_in_list": true,
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "namespace": {
            "description": "来源命名空间",
            "type": "string",
            "hint": "用于生成唯一图片 ID，仅可使用字母、数字、点、下划线和连字符。",
            "default": "json-library"
          },
          "index_path": {
            "description": "JSON 索引绝对路径",
            "type": "string",
            "default": ""
          },
          "data_root": {
            "description": "图片数据根目录绝对路径",
            "type": "string",
            "default": ""
          }
        }
      },
      "directory": {
        "name": "目录扫描来源",
        "hint": "扫描目录中的常见图片文件，目录名和文件名会自动成为标签。",
        "display_item": "namespace",
        "hide_hint_in_list": true,
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "namespace": {
            "description": "来源命名空间",
            "type": "string",
            "hint": "每个来源必须唯一；managed 和 legacy 为保留名称。",
            "default": "directory-library"
          },
          "root": {
            "description": "图片目录绝对路径",
            "type": "string",
            "default": ""
          },
          "recursive": {
            "description": "递归扫描子目录",
            "type": "bool",
            "default": true
          },
          "tags": {
            "description": "应用到此来源全部图片的标签",
            "type": "list",
            "default": []
          }
        }
      }
    }
  },
  "max_match_candidates": {
    "description": "关键词匹配候选上限",
    "type": "int",
    "hint": "最多返回多少张候选图片供选择",
    "default": 10
  },
  "min_tag_score": {
    "description": "最低匹配分数阈值",
    "type": "float",
    "hint": "低于此分数的候选不被考虑，0表示不限制",
    "default": 0.0
  },
  "selection_mode": {
    "description": "模板选择策略",
    "type": "string",
    "hint": "weighted: 按分数加权随机选择；top: 每次取最高分；random: 在候选池中随机选择",
    "options": ["weighted", "top", "random"],
    "default": "weighted"
  },
  "selection_pool_size": {
    "description": "探索候选池大小",
    "type": "int",
    "hint": "从前 N 个高分候选中进行智能选择",
    "default": 5
  },
  "selection_cooldown_seconds": {
    "description": "会话冷却秒数",
    "type": "float",
    "hint": "同一 UMO 在此时间内尽量不重复发送同一张图",
    "default": 300.0
  },
  "selection_history_size": {
    "description": "每个会话最近记录数",
    "type": "int",
    "hint": "限制内存中的最近发送记录，防止无限增大",
    "default": 20
  },
  "deduplicate_files": {
    "description": "启用图片内容去重",
    "type": "bool",
    "hint": "候选中的相同文件内容只保留一张，按文件内容摘要判断",
    "default": true
  },
  "auto_refresh": {
    "description": "启动时自动加载索引",
    "type": "bool",
    "hint": "是否在插件启动时自动加载 image_index.json",
    "default": true
  },
  "tag_synonyms": {
    "description": "标签同义词映射",
    "type": "object",
    "hint": "格式: {\"哈哈\":\"大笑\",\"猫猫\":\"猫\"}，用于扩展搜索匹配",
    "default": {},
    "items": {}
  },
  "match_mode": {
    "description": "表情包匹配模式",
    "type": "string",
    "hint": "keyword: 关键词匹配(默认); embedding: 向量语义匹配; hybrid: 关键词粗筛+向量精排",
    "options": ["keyword", "embedding", "hybrid"],
    "default": "keyword"
  },
  "embedding_provider_id": {
    "description": "向量匹配使用的 Embedding Provider ID",
    "type": "string",
    "hint": "留空则自动选择第一个可用的 embedding provider",
    "default": ""
  },
  "embedding_fallback": {
    "description": "向量匹配失败时回退到关键词匹配",
    "type": "bool",
    "hint": "当 embedding provider 不可用或出错时自动降级",
    "default": true
  },
  "thumbnail_size": {
    "description": "WebUI 缩略图边长(px)",
    "type": "int",
    "hint": "缩略图最大边长",
    "default": 200
  }
}
